# Default development mode: backend services read database/fixtures/*.json.
KAMBARU_DATA_SOURCE=mock

# Change KAMBARU_DATA_SOURCE to "supabase" after applying migrations and importing data.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Browser-safe values used later when Supabase Auth is connected.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
