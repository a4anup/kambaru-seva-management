{
  "name": "kambaru-devi-seva",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @kambaru/frontend",
    "build": "npm run build -w @kambaru/frontend",
    "start": "npm run start -w @kambaru/frontend",
    "lint": "npm run lint -w @kambaru/frontend",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.58.2",
    "esbuild": "0.27.3"
  }
}
